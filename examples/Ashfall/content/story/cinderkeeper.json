{
  "$schema": "../../../../schema/definition.schema.json",
  // The Cinderkeeper quest: an NPC asks you to bring back an ember from a husk, and pays in rings.
  // The character and quest templates are examples: swap in the real blueprints you pick in FModel.
  "definitions": [
    {
      "kind": "animationSet",
      "id": "HuskMoves",
      "skeleton": "/Game/Characters/Root/Common/SK_Root_Grunt_Skeleton.SK_Root_Grunt_Skeleton",
      "animations": {
        "Attack_Swipe": { "files": ["animations/husk_swipe.fbx"], "blendTime": 0.1 },
        "Idle": { "files": ["animations/husk_idle.fbx", "animations/husk_idle_twitch.fbx"], "loop": true }
      }
    },
    {
      "kind": "lootTable",
      "id": "HuskDrops",
      "tableType": "IndividualChance",
      "entries": [
        { "item": "SmolderingEmber", "chance": 100 }
      ]
    },
    {
      "kind": "enemy",
      "id": "AshHusk",
      "template": "/Game/Characters/Root/Grunt/Character_Root_Grunt.Character_Root_Grunt_C",
      "name": "Ash Husk",
      "animBlueprint": {
        "template": "/Game/Characters/Root/Grunt/ABP_Root_Grunt.ABP_Root_Grunt_C",
        "layers": { "Base": "HuskMoves" }
      },
      "stats": { "HealthMax": 420 },
      "loot": "HuskDrops"
    },
    {
      "kind": "lootTable",
      "id": "AshfallEncounters",
      "tableType": "List",
      "entries": [
        { "character": "AshHusk", "chance": 100, "quantity": 3 }
      ]
    },
    {
      "kind": "questItem",
      "id": "SmolderingEmber",
      "template": "/Game/World_Fae/Items/CrimsonKingCoin/Quest_Item_CrimsonKingCoin.Quest_Item_CrimsonKingCoin_C",
      "name": "Smoldering Ember",
      "description": "Still warm. The Cinderkeeper wants it.",
      "icon": { "small": "art/ember_heart_icon.png" },
      "quest": "CinderkeeperQuest"
    },
    {
      "kind": "dialogue",
      "id": "CinderkeeperTalk",
      "nodes": [
        {
          "trigger": "Interact",
          "then": [
            { "id": "Greeting", "say": "You smell of smoke. Good. The fire likes you." },
            { "once": true, "activateObjective": "FindEmber" },
            {
              "choices": [
                { "label": "What do you need?", "then": [
                  { "say": "An ember from a husk. They carry the last of the old flame." },
                  { "jump": "Greeting" }
                ] },
                { "label": "Show me your wares.", "then": [ { "event": "OpenVendor" } ] },
                { "label": "Leave.", "then": [ { "exit": true } ] }
              ]
            }
          ]
        },
        {
          "onItem": "SmolderingEmber",
          "then": [
            { "say": "Ahh. Still burning. Take this, and keep it lit." },
            { "completeObjective": "FindEmber" },
            { "completeQuest": "Success" }
          ]
        }
      ]
    },
    {
      "kind": "npc",
      "id": "Cinderkeeper",
      "name": "The Cinderkeeper",
      "template": "/Game/Characters/NPC/Common/Character_NPC.Character_NPC_C",
      "dialogue": "CinderkeeperTalk",
      "vendor": {
        "items": [ { "item": "EmberHeart", "scrap": 2500 } ]
      }
    },
    {
      "kind": "quest",
      "id": "CinderkeeperQuest",
      "assetName": "Quest_Injectable_Cinderkeeper",
      "template": "/Game/World_Fae/Quests/Quest_Injectable_BurningCity_Rookery/Quest_Injectable_BurningCity_Rookery.Quest_Injectable_BurningCity_Rookery_C",
      "name": "The Cinderkeeper",
      "description": "Bring an ember back to the keeper of the last fire.",
      "levelMin": 1,
      "levelMax": 20,
      "container": "/Game/Dimensions/Ashfall/Maps/Cinderkeeper_Tile.Cinderkeeper_Tile",
      "objectives": [
        { "id": "FindEmber", "name": "Bring the Cinderkeeper a smoldering ember" }
      ],
      "entities": [
        { "id": "Keeper", "name": "The Cinderkeeper", "npc": "Cinderkeeper", "dialogue": "CinderkeeperTalk" }
      ]
    }
  ]
}
