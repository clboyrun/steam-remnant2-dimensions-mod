<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Loads, merges and validates Dimensions content definitions (JSON).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\schema\*.schema.json" LogicalName="schema/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
