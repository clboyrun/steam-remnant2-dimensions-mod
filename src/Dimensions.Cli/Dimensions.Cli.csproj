<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dimensions</AssemblyName>
    <RootNamespace>Dimensions.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dimensions.Pipeline\Dimensions.Pipeline.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The editor script ships next to the CLI so `dimensions build` finds it without a repo checkout. -->
    <Content Include="..\..\unreal\Python\**\*.py" LinkBase="unreal\Python" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\unreal\Plugins\**\*" LinkBase="unreal\Plugins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
