{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimensions content file",
  "description": "One definition, or { \"definitions\": [ ... ] } holding several. Each definition has a kind and an id.",
  "anyOf": [
    {
      "$ref": "#/$defs/definition"
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/definition"
          }
        }
      },
      "required": [
        "definitions"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "extends": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "Another definition of the same kind to copy from. Objects merge key by key, everything else is replaced."
        },
        "abstract": {
          "type": "boolean",
          "description": "Only used as a base for 'extends'; nothing is generated for it."
        },
        "template": {
          "$ref": "common.schema.json#/$defs/gamePath",
          "description": "The game class or asset this is made from. Blueprints become children of it; other assets are copies of it."
        },
        "assetName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Overrides the generated asset name."
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "flavorText": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "icon": {
          "$ref": "common.schema.json#/$defs/icon"
        },
        "acquisition": {
          "$ref": "common.schema.json#/$defs/acquisition"
        },
        "properties": {
          "$ref": "common.schema.json#/$defs/properties"
        },
        "components": {
          "$ref": "common.schema.json#/$defs/components"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "definition": {
      "oneOf": [
        {
          "$ref": "#/$defs/weapon"
        },
        {
          "$ref": "#/$defs/weaponMod"
        },
        {
          "$ref": "#/$defs/mutator"
        },
        {
          "$ref": "#/$defs/ring"
        },
        {
          "$ref": "#/$defs/amulet"
        },
        {
          "$ref": "#/$defs/armor"
        },
        {
          "$ref": "#/$defs/trait"
        },
        {
          "$ref": "#/$defs/archetype"
        },
        {
          "$ref": "#/$defs/lootTable"
        },
        {
          "$ref": "#/$defs/world"
        },
        {
          "$ref": "#/$defs/adventure"
        },
        {
          "$ref": "#/$defs/blueprint"
        }
      ]
    },
    "weapon": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "weapon"
        },
        "weaponType": {
          "enum": [
            "longGun",
            "handGun",
            "melee"
          ]
        },
        "model": {
          "$ref": "common.schema.json#/$defs/model"
        },
        "stats": {
          "description": "Ranged: the FRangedWeaponData row. Melee: the melee stats row. Any extra key is passed through as a row field.",
          "type": "object",
          "properties": {
            "damage": {
              "type": "integer",
              "minimum": 0
            },
            "rateOfFire": {
              "type": "number",
              "minimum": 0
            },
            "magazine": {
              "type": "integer",
              "minimum": 0,
              "description": "AmmoPerClip."
            },
            "maxAmmo": {
              "type": "integer",
              "minimum": 0
            },
            "ammoPerReload": {
              "type": "integer",
              "minimum": 0
            },
            "range": {
              "type": "number",
              "minimum": 0
            },
            "falloffStart": {
              "type": "number",
              "minimum": 0,
              "description": "PrimaryFalloff."
            },
            "falloffEnd": {
              "type": "number",
              "minimum": 0,
              "description": "SecondaryFalloff."
            },
            "spread": {
              "type": "number",
              "minimum": 0
            },
            "pellets": {
              "type": "integer",
              "minimum": 1,
              "description": "SprayCount."
            },
            "automatic": {
              "type": "boolean"
            },
            "burstCount": {
              "type": "integer",
              "minimum": 0
            },
            "burstRateOfFire": {
              "type": "number",
              "minimum": 0
            },
            "scope": {
              "type": "boolean"
            },
            "scopeFov": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          }
        },
        "statsRow": {
          "description": "Use this existing stats row instead of generating one from 'stats'.",
          "type": "object",
          "properties": {
            "table": {
              "$ref": "common.schema.json#/$defs/gamePath"
            },
            "row": {
              "type": "string"
            }
          },
          "required": [
            "table",
            "row"
          ],
          "additionalProperties": false
        },
        "mod": {
          "$ref": "common.schema.json#/$defs/ref",
          "description": "A fixed weapon mod (boss weapons). Omit for a free mod slot."
        },
        "mutatorSlot": {
          "type": "boolean",
          "default": true
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "weaponType"
          ]
        }
      ]
    },
    "weaponMod": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "weaponMod"
        },
        "powerRequired": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Mod power needed per charge (PowerBasis)."
        },
        "charges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "MaxCharges."
        },
        "toggleable": {
          "type": "boolean"
        },
        "stats": {
          "$ref": "common.schema.json#/$defs/stats"
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ]
    },
    "mutator": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "mutator"
        },
        "slot": {
          "enum": [
            "ranged",
            "melee"
          ]
        },
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10
        },
        "levels": {
          "description": "Stats at each level, first entry is level 1. Shorter arrays are padded with the last entry.",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/stats"
          }
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "template",
            "slot"
          ]
        }
      ]
    },
    "ring": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "ring"
        },
        "stats": {
          "$ref": "common.schema.json#/$defs/stats"
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ]
    },
    "amulet": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "amulet"
        },
        "stats": {
          "$ref": "common.schema.json#/$defs/stats"
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ]
    },
    "armor": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "armor"
        },
        "slot": {
          "enum": [
            "head",
            "body",
            "hands",
            "legs"
          ]
        },
        "model": {
          "$ref": "common.schema.json#/$defs/model"
        },
        "armor": {
          "type": "number",
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "resistances": {
          "type": "object",
          "properties": {
            "bleed": {
              "type": "number"
            },
            "fire": {
              "type": "number"
            },
            "shock": {
              "type": "number"
            },
            "blight": {
              "type": "number"
            },
            "toxin": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "stats": {
          "$ref": "common.schema.json#/$defs/stats"
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "template",
            "slot"
          ]
        }
      ]
    },
    "trait": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "trait"
        },
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10
        },
        "cost": {
          "type": "integer",
          "minimum": 0
        },
        "levels": {
          "description": "Stat name to one value per level.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          }
        }
      },
      "unevaluatedProperties": false
    },
    "archetype": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "archetype"
        },
        "briefDescription": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "flavorTags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "image": {
          "$ref": "common.schema.json#/$defs/textureSource",
          "description": "The archetype's portrait."
        },
        "archetypeTrait": {
          "description": "The archetype's own trait (levels and perks).",
          "type": "object",
          "properties": {
            "template": {
              "$ref": "common.schema.json#/$defs/gamePath"
            },
            "levels": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "properties": {
              "$ref": "common.schema.json#/$defs/properties"
            }
          },
          "additionalProperties": false
        },
        "engram": {
          "description": "The engram item that unlocks the archetype.",
          "type": "object",
          "properties": {
            "template": {
              "$ref": "common.schema.json#/$defs/gamePath"
            },
            "name": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "description": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "icon": {
              "$ref": "common.schema.json#/$defs/icon"
            },
            "acquisition": {
              "$ref": "common.schema.json#/$defs/acquisition"
            },
            "properties": {
              "$ref": "common.schema.json#/$defs/properties"
            }
          },
          "additionalProperties": false
        },
        "startingGear": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "startingTraits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trait": {
                "$ref": "common.schema.json#/$defs/ref"
              },
              "level": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "trait"
            ],
            "additionalProperties": false
          }
        },
        "uiTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registration": {
          "$ref": "common.schema.json#/$defs/registration"
        }
      },
      "unevaluatedProperties": false
    },
    "lootTable": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "lootTable"
        },
        "tableType": {
          "type": "string",
          "description": "ESpawnTableType name, for example 'Single' or 'All'."
        },
        "rolls": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "$ref": "common.schema.json#/$defs/ref"
              },
              "table": {
                "$ref": "common.schema.json#/$defs/ref",
                "description": "A nested spawn table instead of an item."
              },
              "chance": {
                "type": "integer",
                "minimum": 0,
                "default": 100
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              },
              "levelMin": {
                "type": "integer",
                "minimum": 0
              },
              "levelMax": {
                "type": "integer",
                "minimum": 0
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "item"
                ]
              },
              {
                "required": [
                  "table"
                ]
              }
            ],
            "additionalProperties": false
          }
        },
        "injectInto": {
          "description": "Existing game spawn tables that get this table as a new entry.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table": {
                "$ref": "common.schema.json#/$defs/gamePath"
              },
              "chance": {
                "type": "integer",
                "minimum": 0,
                "default": 100
              }
            },
            "required": [
              "table"
            ],
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "world": {
      "description": "A new world (biome): its zones, maps and loot. Maps are built by hand in the Unreal project under /Game/Dimensions/<id>/ and referenced here.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "world"
        },
        "biomeName": {
          "type": "string",
          "description": "Internal biome name the quest and save use."
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "template": {
                "$ref": "common.schema.json#/$defs/gamePath",
                "description": "An existing ZoneDef to make the zone from. Default: the native ZoneDef class."
              },
              "maps": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/gamePath"
                },
                "description": "MapTemplates."
              },
              "tileSet": {
                "$ref": "common.schema.json#/$defs/gamePath"
              },
              "loot": {
                "$ref": "common.schema.json#/$defs/ref",
                "description": "Spawn table for this zone's spawn list."
              },
              "encounters": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/ref"
                }
              },
              "properties": {
                "$ref": "common.schema.json#/$defs/properties"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "loot": {
          "$ref": "common.schema.json#/$defs/ref",
          "description": "World-wide loot table."
        },
        "registration": {
          "$ref": "common.schema.json#/$defs/registration"
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "zones"
          ]
        }
      ]
    },
    "adventure": {
      "description": "An Adventure mode option: a root quest that rolls one world.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "adventure"
        },
        "world": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "container": {
          "$ref": "common.schema.json#/$defs/gamePath",
          "description": "The persistent container map the quest streams zones into."
        },
        "levelMin": {
          "type": "integer",
          "minimum": 0
        },
        "levelMax": {
          "type": "integer",
          "minimum": 0
        },
        "rarity": {
          "type": "string",
          "description": "ERemnantQuestRarity name."
        },
        "storyline": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          },
          "description": "Sub-quests (story and injectables)."
        },
        "rewards": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "registration": {
          "$ref": "common.schema.json#/$defs/registration"
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "template",
            "world"
          ]
        }
      ]
    },
    "blueprint": {
      "description": "Anything else: a child blueprint of any game class with raw property overrides.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "blueprint"
        },
        "folder": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_/]+$",
          "description": "Folder under the dimension's content root."
        },
        "asset": {
          "enum": [
            "blueprint",
            "copy",
            "dataAsset"
          ],
          "default": "blueprint"
        }
      },
      "unevaluatedProperties": false,
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ]
    }
  }
}
